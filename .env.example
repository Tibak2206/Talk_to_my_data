ANTHROPIC_API_KEY=sk-ant-...
# Requis uniquement si ta cle API est "identity-linked" (erreur 400
# "anthropic-workspace-id is required..." sinon). ID du workspace, format
# wrkspc_... , visible dans platform.claude.com > Settings > Workspaces.
ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Optionnel : observabilite/traces des appels a l'agent (dashboard Langfuse).
# Sans ces cles, l'app fonctionne normalement, juste sans traces. Cles a
# recuperer sur cloud.langfuse.com (ou us.cloud.langfuse.com pour la region US).
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
